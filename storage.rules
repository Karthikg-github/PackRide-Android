rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && fileName.matches('^(avatar|banner)\\.jpg$')
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Canonical cross-platform replay path used by both Android and iOS.
    match /users/{uid}/rides/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && fileName.matches('^.+\\.gpx$')
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('application/(gpx.*|octet-stream)');
    }
    match /feedPhotos/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    // Legacy app versions did not attach ownerUid. Creation is
                    // still safe because an existing object cannot be replaced;
                    // current versions attach ownerUid for later update/delete.
                    && (!("ownerUid" in request.resource.metadata)
                        || request.resource.metadata.ownerUid == request.auth.uid)
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update: if request.auth != null
                    && resource.metadata.ownerUid == request.auth.uid
                    && request.resource.metadata.ownerUid == request.auth.uid
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && resource.metadata.ownerUid == request.auth.uid;
    }
    match /rideGpx/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('application/gpx.*');
    }
    match /sharedLapGpx/{ownerUid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == ownerUid
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('application/gpx.*');
    }
  }
}
