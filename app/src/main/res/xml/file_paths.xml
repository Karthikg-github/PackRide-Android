<?xml version="1.0" encoding="utf-8"?>
<!-- Aug 30, 2026 — backs the FileProvider used to share/export a ride's GPX
     file (Ride History's "Export GPX" / "Share" actions). Only exposes the
     rides/ subfolder GPXStorage/GPXRecorder actually write to, not the whole
     internal files dir. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="rides" path="rides/" />
    <cache-path name="share_cards" path="share_cards/" />
</paths>
