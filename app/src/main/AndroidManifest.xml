<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Location: fine for tracking; background for rides / crash / Need Help -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice chat (group ride intercom, Agora RTC) — mic capture plus the
         standard audio-routing permission Agora needs alongside it. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".PackRideApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PackRide">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.PackRide"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link: packride://join?code=XXXX (parity with iOS) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="packride" android:host="join" />
            </intent-filter>
            <!-- Deep link: packride://joincommunity?id=XXXX&passcode=YYYY (parity with iOS) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="packride" android:host="joincommunity" />
            </intent-filter>
        </activity>

        <!-- Keeps GPS alive while rideTracking / lapTracking / needHelp / crashDetection -->
        <service
            android:name=".location.LocationTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Keeps an active Ride Comms / group intercom call alive when the
             screen locks or PackRide moves to the background. -->
        <service
            android:name=".voice.VoiceCommsService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Real key lives in local.properties (MAPS_API_KEY=...), read via
             manifestPlaceholders in app/build.gradle.kts. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />
    
        <service
            android:name=".notify.PackRideMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    
        <!-- AdMob App ID: replace ~000 with your Android AdMob app id from console.
             Until then Google test app id is used so banners still load in dev. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-2444709882752151~3542151530"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="packride_updates" />

        <!-- Aug 30, 2026 — backs Ride History's Export GPX / Share Stats
             actions, which need a content:// Uri to hand another app (Files,
             Mail, Drive, etc.) rather than a raw file:// path. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
